# Required: your v0 Platform API key (Premium/Team plan with usage-based billing).
# Get one at https://v0.dev/chat/settings/keys
# NOTE: Do not use your production API key
V0_API_KEY=

# Optional: set to 1 to log end-user prompt content in the server logs.
# Off by default so prompt text isn't logged; the API key is never logged.
V0_DEBUG=
